[zh-cn]
name = "服务中心"
auth = "shh"
descript = "回答「我的 NAS 到底在跑什么」。读取内核的监听套接字表建立端口地图，把常见端口解析成服务名，并按指纹识别 NAS 常见服务——SMB、NFS、SSH、Web、FTP、WebDAV 等——给出是否在监听。系统上可用 Docker 命令行时，列出容器名、镜像、状态、映射端口与运行时长。每个识别到的 Web 服务都带一个「打开」按钮，地址由你当前访问 NAS 所用的地址推导而来，不必自己去查端口号。整个应用是只读的：不启动、不停止、不重启、不修改任何服务或容器，也不会代你执行命令。历史视图记录端口地图随时间的变化。"
release_note = "1. 首次发布。"
important = "严格只读。不会启动、停止、重启或修改任何服务与容器。"

[zh-hk]
name = "服務中心"
auth = "shh"
descript = "回答「我的 NAS 到底在跑什麼」。讀取核心的監聽通訊端表建立連接埠地圖，把常見連接埠解析成服務名，並依指紋辨識 NAS 常見服務——SMB、NFS、SSH、Web、FTP、WebDAV 等——給出是否在監聽。系統上可用 Docker 命令列時，列出容器名稱、映像、狀態、對應連接埠與運行時長。每個辨識到的 Web 服務都帶一個「開啟」按鈕，位址由你目前存取 NAS 所用的位址推導而來。整個應用是唯讀的：不啟動、不停止、不重啟、不修改任何服務或容器，也不會代你執行命令。歷史檢視記錄連接埠地圖隨時間的變化。"
release_note = "1. 首次發佈。"
important = "嚴格唯讀。不會啟動、停止、重啟或修改任何服務與容器。"

[en-us]
name = "Service Center"
auth = "shh"
descript = "Answers what your TNAS is actually running. Reads the kernel listening-socket tables to build a port map, resolves well-known ports to service names and fingerprints common NAS services (SMB, NFS, SSH, Web, FTP, WebDAV), reporting what is listening. Docker containers are listed with name, image, status, ports and uptime when the Docker command line is available. Every web service gets an open button whose address is derived from the address you reached the NAS on. Strictly read-only."
release_note = "1. Initial release."
important = "Strictly read-only. No service or container is ever started, stopped, restarted or modified."

[fr-fr]
name = "Centre de services"
auth = "shh"
descript = "Que fait réellement mon NAS ? Lit la table des sockets en écoute du noyau, dresse une carte des ports, nomme les ports courants et identifie les services NAS habituels — SMB, NFS, SSH, Web, FTP, WebDAV — en indiquant s'ils écoutent. Si la commande Docker est présente, elle liste conteneurs, images, états et ports mappés. Chaque service web reconnu a un bouton Ouvrir, dont l'adresse découle de celle que vous utilisez pour joindre le NAS. Une vue historique suit l'évolution de la carte."
release_note = "1. Première version."
important = "Strictement en lecture seule. Aucun service ni conteneur n'est démarré, arrêté, redémarré ou modifié."

[de-de]
name = "Dienstzentrale"
auth = "shh"
descript = "Was läuft auf meinem NAS wirklich? Liest die Tabelle lauschender Sockets im Kernel, erstellt eine Portkarte, benennt gängige Ports und erkennt übliche NAS-Dienste — SMB, NFS, SSH, Web, FTP, WebDAV — samt Status. Ist die Docker-CLI vorhanden, listet sie Container, Images, Zustände und gemappte Ports. Jeder erkannte Webdienst hat eine Schaltfläche Öffnen, deren Adresse sich aus der von Ihnen genutzten NAS-Adresse ableitet. Eine Verlaufsansicht zeigt, wie sich die Portkarte ändert."
release_note = "1. Erstveröffentlichung."
important = "Strikt nur lesend. Kein Dienst und kein Container wird gestartet, gestoppt, neu gestartet oder verändert."

[it-it]
name = "Centro servizi"
auth = "shh"
descript = "Cosa gira davvero sul mio NAS? Legge la tabella dei socket in ascolto del kernel, costruisce una mappa delle porte, nomina le porte comuni e riconosce i servizi NAS tipici — SMB, NFS, SSH, Web, FTP, WebDAV — dicendo se sono in ascolto. Se il comando Docker è disponibile, elenca container, immagini, stati e porte mappate. Ogni servizio web riconosciuto ha un pulsante Apri, il cui indirizzo deriva da quello che usi per raggiungere il NAS. Una vista storica mostra come cambia la mappa."
release_note = "1. Prima versione."
important = "Rigorosamente in sola lettura. Nessun servizio o container viene avviato, fermato, riavviato o modificato."

[es-es]
name = "Centro de servicios"
auth = "shh"
descript = "¿Qué corre realmente en mi NAS? Lee la tabla de sockets a la escucha del kernel, traza un mapa de puertos, nombra los puertos comunes e identifica los servicios NAS típicos — SMB, NFS, SSH, Web, FTP, WebDAV — indicando si escuchan. Si existe el comando Docker, lista contenedores, imágenes, estados y puertos mapeados. Cada servicio web reconocido tiene un botón Abrir, cuya dirección se deduce de la que usas para llegar al NAS. Una vista de historial sigue la evolución del mapa."
release_note = "1. Primera versión."
important = "Estrictamente de solo lectura. No se inicia, detiene, reinicia ni modifica ningún servicio ni contenedor."

[hu-hu]
name = "Szolgáltatásközpont"
auth = "shh"
descript = "Mi fut valójában a NAS-omon? Beolvassa a kernel figyelő socketjeit, porttérképet készít, megnevezi a gyakori portokat, és felismeri a szokásos NAS-szolgáltatásokat — SMB, NFS, SSH, Web, FTP, WebDAV —, jelezve, figyelnek-e. Ha van Docker-parancs, kilistázza a konténereket, image-eket, állapotokat és leképezett portokat. Minden felismert webszolgáltatásnál van Megnyitás gomb, címe abból származik, amelyen a NAS-t eléri. Az előzmények nézet mutatja a porttérkép változását."
release_note = "1. Első kiadás."
important = "Szigorúan csak olvasás. Egyetlen szolgáltatás vagy konténer sem indul, áll le, indul újra vagy módosul."

[ja-jp]
name = "サービスセンター"
auth = "shh"
descript = "私の NAS では実際に何が動いているのか。カーネルの待ち受けソケット表を読み、ポートマップを作り、よく使うポートにサービス名を付け、NAS 定番のサービス（SMB、NFS、SSH、Web、FTP、WebDAV）を指紋で識別して待ち受けの有無を示します。Docker コマンドがあれば、コンテナー名・イメージ・状態・割り当てポートを一覧します。認識した Web サービスには開くボタンが付き、アドレスは今 NAS にアクセスしているアドレスから導出されます。履歴ビューでポートマップの変化を追えます。"
release_note = "1. 初回リリース。"
important = "厳密に読み取り専用です。サービスやコンテナーの起動・停止・再起動・変更は一切行いません。"

[ko-kr]
name = "서비스 센터"
auth = "shh"
descript = "내 NAS에서 실제로 무엇이 돌고 있을까요? 커널의 수신 대기 소켓 표를 읽어 포트 지도를 만들고, 흔한 포트에 서비스 이름을 붙이며, NAS의 대표 서비스(SMB, NFS, SSH, Web, FTP, WebDAV)를 지문으로 식별해 대기 여부를 보여줍니다. Docker 명령이 있으면 컨테이너 이름·이미지·상태·매핑된 포트를 나열합니다. 인식된 웹 서비스에는 열기 버튼이 붙고, 주소는 지금 NAS에 접속한 주소에서 유도됩니다. 기록 보기에서 포트 지도의 변화를 볼 수 있습니다."
release_note = "1. 최초 릴리스."
important = "엄격히 읽기 전용입니다. 어떤 서비스나 컨테이너도 시작·중지·재시작·수정하지 않습니다."

[pl-pl]
name = "Centrum usług"
auth = "shh"
descript = "Co naprawdę działa na moim NAS? Czyta tablicę gniazd nasłuchujących jądra, tworzy mapę portów, nazywa typowe porty i rozpoznaje znane usługi NAS — SMB, NFS, SSH, Web, FTP, WebDAV — wskazując, czy nasłuchują. Gdy dostępne jest polecenie Docker, wypisuje kontenery, obrazy, stany i zmapowane porty. Każda rozpoznana usługa webowa ma przycisk Otwórz, którego adres wynika z tego, po którym łączysz się z NAS. Widok historii pokazuje zmiany mapy portów."
release_note = "1. Pierwsze wydanie."
important = "Ściśle tylko odczyt. Żadna usługa ani kontener nie są uruchamiane, zatrzymywane, restartowane czy zmieniane."

[ru-ru]
name = "Центр служб"
auth = "shh"
descript = "Что на самом деле работает на моём NAS? Читает таблицу прослушиваемых сокетов ядра, строит карту портов, называет типовые порты и распознаёт обычные службы NAS — SMB, NFS, SSH, Web, FTP, WebDAV — указывая, слушают ли они. Если доступна команда Docker, выводит контейнеры, образы, состояния и проброшенные порты. У каждой распознанной веб-службы есть кнопка Открыть, адрес которой выводится из того, по которому вы обращаетесь к NAS. История показывает изменения карты портов."
release_note = "1. Первый выпуск."
important = "Строго только чтение. Ни одна служба или контейнер не запускается, не останавливается, не перезапускается и не изменяется."

[tr-tr]
name = "Hizmet merkezi"
auth = "shh"
descript = "NAS'ımda gerçekte ne çalışıyor? Çekirdeğin dinleyen soket tablosunu okur, port haritası çıkarır, yaygın portları adlandırır ve bilinen NAS servislerini — SMB, NFS, SSH, Web, FTP, WebDAV — parmak iziyle tanıyıp dinleyip dinlemediklerini gösterir. Docker komutu varsa kapsayıcıları, imajları, durumları ve eşlenen portları listeler. Tanınan her web servisinin bir Aç düğmesi vardır; adresi NAS'a eriştiğiniz adresten türetilir. Geçmiş görünümü port haritasının değişimini izler."
release_note = "1. İlk sürüm."
important = "Kesinlikle salt okunur. Hiçbir servis veya kapsayıcı başlatılmaz, durdurulmaz, yeniden başlatılmaz veya değiştirilmez."

[pt-pt]
name = "Centro de serviços"
auth = "shh"
descript = "O que corre realmente no meu NAS? Lê a tabela de sockets à escuta do kernel, traça um mapa de portas, nomeia as portas comuns e identifica os serviços NAS típicos — SMB, NFS, SSH, Web, FTP, WebDAV — indicando se estão à escuta. Se o comando Docker existir, lista contentores, imagens, estados e portas mapeadas. Cada serviço web reconhecido tem um botão Abrir, cujo endereço deriva do que usa para chegar ao NAS. Uma vista de histórico acompanha a evolução do mapa."
release_note = "1. Primeira edição."
important = "Estritamente só de leitura. Nenhum serviço ou contentor é iniciado, parado, reiniciado ou modificado."
